{
  "name": "@srgnt/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-facing core for srgnt: ACP SDK wrapper, typed update stream, capability model (pure Node, no Electron)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-harness-boundary.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@srgnt/contracts": "workspace:*",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@srgnt/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
